    (6) sentencia -> IF expresion COLON lista_sentencias ELSE COLON lista_sentencias ENDIF . SEMICOLON

    SEMICOLON       shift and go to state 46


state 46

    (6) sentencia -> IF expresion COLON lista_sentencias ELSE COLON lista_sentencias ENDIF SEMICOLON .

    ID              reduce using rule 6 (sentencia -> IF expresion COLON lista_sentencias ELSE COLON lista_sentencias ENDIF SEMICOLON .)
    PRINT           reduce using rule 6 (sentencia -> IF expresion COLON lista_sentencias ELSE COLON lista_sentencias ENDIF SEMICOLON .)
    IF              reduce using rule 6 (sentencia -> IF expresion COLON lista_sentencias ELSE COLON lista_sentencias ENDIF SEMICOLON .)
    $end            reduce using rule 6 (sentencia -> IF expresion COLON lista_sentencias ELSE COLON lista_sentencias ENDIF SEMICOLON .)
    ELSE            reduce using rule 6 (sentencia -> IF expresion COLON lista_sentencias ELSE COLON lista_sentencias ENDIF SEMICOLON .)
    ENDIF           reduce using rule 6 (sentencia -> IF expresion COLON lista_sentencias ELSE COLON lista_sentencias ENDIF SEMICOLON .)

